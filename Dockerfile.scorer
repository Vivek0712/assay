# Scoring fleet for Bedrock AgentCore Runtime.
# AgentCore requires linux/arm64 and an HTTP server exposing /invocations
# and /ping on 0.0.0.0:8080.
FROM --platform=linux/arm64 public.ecr.aws/docker/library/python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8080

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY agentcore_scorer.py ./
RUN pip install --no-cache-dir . "uvicorn>=0.30" "starlette>=0.37"

EXPOSE 8080

CMD ["python", "agentcore_scorer.py"]
